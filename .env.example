# Generation and verification models use any OpenAI Chat Completions-compatible endpoint.
# Change the model/provider configuration and restart the backend to apply it.
GENERATION_MODEL=openai/gpt-oss-20b
GENERATION_API_BASE_URL=https://api.groq.com/openai/v1
GENERATION_API_KEY=
WEB_GENERATION_MODEL=openai/gpt-oss-20b
VERIFICATION_MODEL=openai/gpt-oss-20b
VERIFICATION_API_BASE_URL=https://api.groq.com/openai/v1
VERIFICATION_API_KEY=
# Legacy Groq settings are accepted as generation defaults for existing deployments.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_WEB_MODEL=openai/gpt-oss-20b
SERPAPI_API_KEY=
RETRIEVAL_SCORE_THRESHOLD=0.5
CHROMA_PERSIST_DIR=.api_data/chroma
CHROMA_COLLECTION_NAME=aoa_documents_local_v2
CHROMA_LEGACY_COLLECTION_NAME=aoa_documents
# PostgreSQL application database. Keep credentials in the local .env only.
DATABASE_URL=postgresql://user:password@localhost:5432/aoa
# Separate local database used by database tests; never use Render here.
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/aoa_test
EMBED_DIM=256
AUTH_SECRET_KEY=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
