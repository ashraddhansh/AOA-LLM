# Groq API key used by the generation layer.
GROQ_API_KEY=
# Use a currently active chat model from https://console.groq.com/docs/models.
GROQ_MODEL=openai/gpt-oss-20b
PATRONUS_API_KEY=
PATRONUS_PROJECT=AOA
PATRONUS_APP=rag-api
CHROMA_PERSIST_DIR=.api_data/chroma
CHROMA_COLLECTION_NAME=aoa_documents_local_v2
